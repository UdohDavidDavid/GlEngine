build main: CXX_EXECUTABLE_LINKER__main_ CMakeFiles/main.dir/main.cpp.o CMakeFiles/main.dir/glad.c.o CMakeFiles/main.dir/stb_image.cpp.o CMakeFiles/main.dir/functions.cpp.o CMakeFiles/main.dir/light.cpp.o CMakeFiles/main.dir/mesh.cpp.o CMakeFiles/main.dir/renderer.cpp.o CMakeFiles/main.dir/shaders.cpp.o CMakeFiles/main.dir/textures.cpp.o CMakeFiles/main.dir/vao.cpp.o CMakeFiles/main.dir/vbo.cpp.o CMakeFiles/main.dir/camera.cpp.o CMakeFiles/main.dir/window.cpp.o CMakeFiles/main.dir/sphere.cpp.o CMakeFiles/main.dir/model.cpp.o CMakeFiles/main.dir/imgui/imgui.cpp.o CMakeFiles/main.dir/imgui/imgui_draw.cpp.o CMakeFiles/main.dir/imgui/imgui_widgets.cpp.o CMakeFiles/main.dir/imgui/imgui_tables.cpp.o CMakeFiles/main.dir/imgui/imgui_demo.cpp.o CMakeFiles/main.dir/imgui/imgui_impl_glfw.cpp.o CMakeFiles/main.dir/imgui/imgui_impl_opengl3.cpp.o CMakeFiles/main.dir/imgizmo/ImGuizmo.cpp.o
  DEP_FILE = CMakeFiles/main.dir/link.d
  LINK_FLAGS = -Wl,--dependency-file=CMakeFiles/main.dir/link.d
  LINK_LIBRARIES = -lGL  -lglfw  -ldl  -lassimp
  OBJECT_DIR = CMakeFiles/main.dir
  POST_BUILD = cd /home/david/c++/opengl/opengl/src/build && /usr/bin/cmake -E copy_directory /home/david/c++/opengl/opengl/src/shaders /home/david/c++/opengl/opengl/src/build/shaders && /usr/bin/cmake -E copy_directory /home/david/c++/opengl/opengl/src/images /home/david/c++/opengl/opengl/src/build/images
  PRE_LINK = :
  TARGET_FILE = main
  TARGET_PDB = main.dbg
  TARGET_SUPPORT_DIR = CMakeFiles/main.dir


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/david/c++/opengl/opengl/src/build && /usr/bin/ccmake -S/home/david/c++/opengl/opengl/src -B/home/david/c++/opengl/opengl/src/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/david/c++/opengl/opengl/src/build && /usr/bin/cmake --regenerate-during-build -S/home/david/c++/opengl/opengl/src -B/home/david/c++/opengl/opengl/src/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

